rules_version = '2';

// Idle Miner Sim — Firestore security rules.
//
// Each player has exactly one document, users/{uid}, holding their game save.
// A player may only touch their own document; everything else is denied.
// Deploy with:  firebase deploy --only firestore:rules --project idle-miner-sim
//
// The save itself is the player's own business and is trusted. Leaderboard
// scores are not: only the validateSync Cloud Function writes them, after
// checking the claim against the server clock (functions/src/validate.ts).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The exact shape the app writes (see FirestoreCloudSaveStore.save).
    function isValidSave() {
      let d = request.resource.data;
      return d.keys().hasOnly(['save', 'lifetimeCoins', 'schemaVersion',
                               'updatedAt', 'platform'])
          && d.keys().hasAll(['save', 'lifetimeCoins', 'schemaVersion',
                              'updatedAt'])
          && d.save is map
          && d.lifetimeCoins is number && d.lifetimeCoins >= 0
          && d.schemaVersion is int && d.schemaVersion >= 1
          && d.updatedAt == request.time
          && (!('platform' in d) || (d.platform is string
                                     && d.platform.size() <= 20));
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidSave();
    }

    // Leaderboard (M4). Written ONLY by the validateSync Cloud Function,
    // which uses the Admin SDK and so bypasses these rules. Players can
    // read it (at most 100 entries per query) but never write it, not
    // even their own entry.
    match /scores/{uid} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 100;
      allow write: if false;
    }

    // Per-player validation state used by validateSync. Server only.
    match /serverState/{uid} {
      allow read, write: if false;
    }

    // Deny everything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
